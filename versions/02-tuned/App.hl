// App.hl : App.c / App.h の写し。アプリケーション（モードの切り替え、スコアなどの共有変数）。

import "System.hl"
import "Sound.hl"
import "Math.hl"
import "Back.hl"
import "Title.hl"
import "Game.hl"
import "pattern.hl"

// マクロの定義
// モード
const APP_MODE_INIT = 0
const APP_MODE_LOAD = 1
const APP_MODE_TITLE = 2
const APP_MODE_GAME = 3
// 状態
const APP_STATE_NULL = 0
const APP_PHASE_NULL = 0

// 変数の定義
var appMode: u8                               // モード
var appState: u8                              // 状態
var appPhase: u8
var appHiscore: [u8; 6]                       // ハイスコア
var appScore: [u8; 6]                         // 現在のスコア
var appRate: [u8; 4]                          // スコアの倍率
var appTimer: [u8; 4]                         // タイマ

// アプリケーションを初期化する
// （元は main から呼ぶ。hlang は割り込みと main で同じ関数を呼べないので、最初の割り込みで呼ぶ）
fn AppInitialize() {
  // スクリーンモードの設定
  SystemSetScreenMode(VIDEO_GRAPHIC1)
  // パターンジェネレータの転送
  LoadVram(VIDEO_GRAPHIC1_PATTERN_GENERATOR_TABLE, &pattern, 0x800)
  // スプライトジェネレータの転送
  LoadVram(VIDEO_GRAPHIC1_SPRITE_GENERATOR_TABLE, &spritePattern, 0x800)
  // アプリケーションの初期化
  for i in 0..6 { appHiscore[i] = 0 }         // ハイスコアの初期化
  appHiscore[2] = 5
  for i in 0..6 { appScore[i] = 0 }           // 現在のスコアの初期化
  for i in 0..4 { appRate[i] = 0 }            // スコアの倍率の初期化
  appRate[1] = 1
  for i in 0..4 { appTimer[i] = 0 }           // タイマの初期化
  appMode = APP_MODE_LOAD                     // モードの初期化
}

// アプリケーションを読み込む
fn AppLoad() {
  BackLoad()                                  // 背景のロード
  videoRegister[VDP_R7] = 0x07                // 背景色の設定
  videoRegister[VDP_R1] |= (1 << VDP_R1_BL) | (1 << VDP_R1_SI)   // スプライトの設定と表示の開始
  request |= 1 << REQUEST_VIDEO_REGISTER      // V-Blank 中の転送の開始
  appMode = APP_MODE_TITLE                    // モードの更新
  appState = TITLE_STATE_INIT                 // 状態の更新
}

// アプリケーションを更新する
fn AppUpdate() {
  if appMode == APP_MODE_INIT {               // 初期化
    SystemInitialize()                        // システムの初期化
    SystemInitializeSound()                   // サウンドの初期化
    AppInitialize()                           // アプリケーションの初期化
  } else if appMode == APP_MODE_LOAD { AppLoad() }           // 読み込み
  else if appMode == APP_MODE_TITLE { TitleUpdate() }        // タイトル画面
  else if appMode == APP_MODE_GAME { GameUpdate() }          // ゲーム画面
  SystemGetRandom()
}
