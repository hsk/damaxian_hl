// main.hl : main.c の写し。メインプログラム（割り込みで 1 フレームずつ進め、main は STOP キーを待つ）。

import "msx.hl"
import "System.hl"
import "App.hl"
import "Sound.hl"

// 変数定義
var h_timiRoutine: [u8; 5]                    // タイマ割り込みの保存

// タイマ割り込みのエントリ
// 元は最後に、保存したルーチンへ jp する。hlang の割り込み関数は BIOS から呼ばれて戻るだけなので、保存したルーチンは呼ばない。
fn H_timiEntry() {
  if (flag & (1 << FLAG_H_TIMI)) == 0 {       // すでに割り込み済みかどうか
    ei()                                      // 割り込み禁止の解除（判定の前でやると、C-BIOS で割り込みが入れ子になり続ける）
    // 処理の開始
    flag |= 1 << FLAG_H_TIMI                  // 割り込みの完了
    if (request & (1 << REQUEST_VIDEO_REGISTER)) != 0 { SystemTransferVideoRegister() }   // ビデオレジスタの転送
    if (request & (1 << REQUEST_VRAM)) != 0 { SystemTransferVram() }                      // VRAM の転送
    SystemTransferSprite()                    // スプライトの転送
    SystemUpdateInput()                       // キー入力の更新
    SystemUpdateSound()                       // サウンドの更新
    if input[INPUT_BUTTON_STOP] == 1 { flag |= 1 << FLAG_CANCEL }   // STOP キーによるキャンセル
    // 処理の完了
    AppUpdate()                               // アプリケーションの更新
    flag &= (1 << FLAG_H_TIMI) ^ 0xff         // 割り込みの完了
  }
}

// メインプログラム
// 初期化（SystemInitialize など）は、割り込みと同じ関数を呼ぶので、最初の割り込みの AppUpdate（APP_MODE_INIT）で行う。
fn main() {
  di()                                        // 割り込みの禁止
  copy(&h_timiRoutine, H_TIMI, 5)             // タイマ割り込み処理の保存
  on_vsync(&H_timiEntry)                      // タイマ割り込み処理の書き換え
  ei()                                        // 割り込み禁止の解除
  while (flag & (1 << FLAG_CANCEL)) == 0 { vsync() }            // キャンセル待ち
  // 終了
  di()                                        // 割り込みの禁止
  copy(H_TIMI, &h_timiRoutine, 5)             // タイマ割り込み処理の復帰
  ei()                                        // 割り込み禁止の解除
}
