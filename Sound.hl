  0x0020, 0x001e, 0x001c, 0x001b, 0x0035, 0x0032, 0x0030, 0x002d, 0x002a, 0x0028, 0x0028, 0x0026, 0x0024, 0x0022, 0x0000, 0x0000,
  0x0010, 0x000d, 0x000e, 0x000d, 0x001b, 0x0019, 0x0018, 0x0016, 0x0015, 0x0014, 0x0014, 0x0013, 0x0012, 0x0011, 0x0000, 0x0000,
]

data soundLengthTable: u8 = [
  0x01, 0x02, 0x03, 0x04, 0x06, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x02, 0x04, 0x06, 0x08, 0x0c, 0x10, 0x18, 0x20, 0x30, 0x40, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x03, 0x06, 0x09, 0x0c, 0x12, 0x18, 0x24, 0x30, 0x48, 0x60, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x04, 0x08, 0x0c, 0x10, 0x18, 0x20, 0x30, 0x40, 0x60, 0x80, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x05, 0x0a, 0x0f, 0x14, 0x1e, 0x28, 0x3c, 0x50, 0x78, 0xa0, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x06, 0x0c, 0x12, 0x18, 0x20, 0x30, 0x48, 0x60, 0x90, 0xc0, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x07, 0x0e, 0x15, 0x1c, 0x2a, 0x38, 0x54, 0x70, 0xa8, 0xe0, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
  0x08, 0x10, 0x18, 0x20, 0x30, 0x40, 0x60, 0x80, 0xc0, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
]

data soundEnvelopeTable: u16 = [
  0x0000, 0x03e8, 0x07d0, 0x0bb8, 0x0fa0, 0x1388, 0x1770, 0x1b58, 0x1f40, 0x2328, 0x2710, 0x2af8, 0x2ee0, 0x32c8, 0x36b0, 0x3a98,
]

// 変数の定義
var soundRequest: [u16; 4]        // 演奏の要求（MML データの番地。0 は要求なし）
var soundHead: [u16; 4]           // MML の先頭（繰り返しで戻る）
var soundPlay: [u16; 4]           // 再生位置（0 なら鳴っていない）
var soundT: [u8; 4]               // テンポ
var soundS: u8                    // エンベロープ波形
var soundM: u8                    // エンベロープ周期
var soundV: [u8; 4]               // 音量
var soundO: [u8; 4]               // オクターブ
var soundL: [u8; 4]               // 音の長さ
var soundFrequency: [u16; 4]      // 周波数（0 は休符）
var soundRest: [u8; 4]            // 次の MML を読むまでのフレーム数
var soundUpdate: [u8; 4]          // PSG を書き換える印
var soundRegister: [u8; 16]       // PSG レジスタの控え

// サウンドのチャンネルをクリアする
fn SystemClearSoundChannel(c: u8) {
  soundT[c] = 0
  soundV[c] = 0x0f
  soundO[c] = 3
  soundL[c] = 5
  soundFrequency[c] = 0
  soundRest[c] = 1
  soundUpdate[c] = 0
}

// サウンドを初期化する
fn SystemInitializeSound() {
  // 1. PSG の初期化
  gicini()
  wrtpsg(0x07, 0xbf)
  // 2. サウンドレジスタの初期化
  for i in 0..16 { soundRegister[i] = 0 }
  soundRegister[0x00] = 0x55
  soundRegister[0x07] = 0xbf
  soundRegister[0x0b] = 0x0b
  // 3. サウンドデータの初期化
  for i in 0..4 {
    soundRequest[i] = 0
    soundHead[i] = 0
    soundPlay[i] = 0
  }
  // 4. サウンドパラメータの初期化
  for i in 0..4 { SystemClearSoundChannel(i) }
  soundS = 0
  soundM = 0x09
}

// 数字が続いていれば（'0'〜'9'）読んで 10 を足した値を返す。続いていなければ first のまま。
// V16 や M12 のように 2 桁のときは「2 桁目 + 10」になる（元の asm の挙動）。
fn soundNumber(p: u16, first: u8) -> u8 {
  var d: u8 = mem[p]
  if d >= '0' && d < '9' + 1 { return d - '0' + 10 }
  return first
}

// 1 チャンネルの MML を読む（待ち時間が 0 になったときだけ呼ぶ）
fn SystemUpdateSoundChannel(c: u8) {
  // 再生ポインタの取得
  var p: u16 = soundPlay[c]
  var rest = false                 // 音の長さの設定まで進んだか
  while !rest {                    // MML の解析
    var a: u8 = mem[p]
    p += 1
    if a == 0 {                    // 0x00 : 終端コード
      soundHead[c] = 0
      soundPlay[c] = 0
      soundFrequency[c] = 0
      soundUpdate[c] = 1
      return
    } else if a == 0xff {          // $ff : 繰り返し
      p = soundHead[c]
    } else if a == 'T' {           // 'T' : テンポ（T1 ～ T8）
      soundT[c] = mem[p] - '1'
      p += 1
    } else if a == 'S' {           // 'S' : エンベロープ波形（S0 ～ S15）
      soundS = mem[p] - '0'
      p += 1
      var n: u8 = soundNumber(p, soundS)
      if n != soundS { soundS = n  p += 1 }
    } else if a == 'M' {           // 'M' : エンベロープ周期（M0 ～ M15）
      soundM = mem[p] - '0'
      p += 1
      var n: u8 = soundNumber(p, soundM)
      if n != soundM { soundM = n  p += 1 }
    } else if a == 'V' {           // 'V' : 音量（V0 ～ V16）
      soundV[c] = mem[p] - '0'
      p += 1
      var n: u8 = soundNumber(p, soundV[c])
      if n != soundV[c] { soundV[c] = n  p += 1 }
    } else if a == 'O' {           // 'O' : オクターブ（O1 ～ O8）
      soundO[c] = mem[p] - '1'
      p += 1
    } else if a == 'L' {           // 'L' : 音の長さ（L0 ～ L9）
      soundL[c] = mem[p] - '0'
      p += 1
    } else {
      if a == 'R' {                // 'R' : 休符
        soundFrequency[c] = 0
      } else {                     // 'A' : 音符（A ～ G。# が付けば半音上）
        var at: u16 = ((soundO[c] as u16) << 4) + (((a - 'A') as u16) << 1)
        if mem[p] == '#' {
          at += 1
          p += 1
        }
        soundFrequency[c] = soundToneFrequencyTable[at]
      }
      // 音の長さの設定
      var len: u8 = mem[p]
      if len >= '0' && len < '9' + 1 {
        p += 1
        len = len - '0'
      } else {
        len = soundL[c]
      }
      soundRest[c] = soundLengthTable[((soundT[c] as u16) << 4) + len]
      soundUpdate[c] = 1
      soundPlay[c] = p
      rest = true
    }
  }
}

// PSG のチャンネル（0 = A, 1 = B, 2 = C）に音量と周波数を書く。bit は音を出すかどうか
fn soundWriteChannel(psg: u8, ch: u8, tone: bool) {
  // TODO(コンパイラ): `1 << psg` のように、変数でシフトできない（「シフトする量は 0〜15 の定数だけ」）。分岐で回避
  var bit: u8 = 1
  if psg == 1 { bit = 2 } else if psg == 2 { bit = 4 }
  if tone { soundRegister[0x07] &= bit ^ 0xff }
  else { soundRegister[0x07] |= bit }
  wrtpsg(0x08 + psg, soundV[ch])
  wrtpsg(psg << 1, soundFrequency[ch] as u8)
  wrtpsg((psg << 1) + 1, (soundFrequency[ch] >> 8) as u8)
}

// サウンドを更新する
fn SystemUpdateSound() {
  // スリープの確認
  if flag & (1 << FLAG_SOUND_SLEEP) != 0 {
    wrtpsg(0x07, 0xbf)
    return
  }
  // チャンネルの走査
  for c in 0..4 {
    // リクエスト
    if soundRequest[c] != 0 {
      soundHead[c] = soundRequest[c]
      soundPlay[c] = soundRequest[c]
      soundRequest[c] = 0
      SystemClearSoundChannel(c)
    }
    // サウンドデータの存在、待機
    if soundPlay[c] != 0 {
      soundRest[c] -= 1
      if soundRest[c] == 0 { SystemUpdateSoundChannel(c) }
    }
  }
  // チャンネルＡの設定（元の asm は、周波数の下位と上位を比べて音の有無を決めている）
  if soundUpdate[0] != 0 {
    soundWriteChannel(0, 0, (soundFrequency[0] as u8) != ((soundFrequency[0] >> 8) as u8))
  }
  // チャンネルＢの設定
  if soundUpdate[1] != 0 { soundWriteChannel(1, 1, soundFrequency[1] != 0) }
  // チャンネルＤの設定（PSG の C を使う。C より優先）
  if soundUpdate[3] != 0 { soundWriteChannel(2, 3, soundFrequency[3] != 0) }
  // チャンネルＣの設定（Ｄが鳴っていないときだけ）
  else if soundUpdate[2] != 0 && soundPlay[3] == 0 { soundWriteChannel(2, 2, soundFrequency[2] != 0) }
  // チャンネル共通の更新
  if (soundUpdate[0] | soundUpdate[1] | soundUpdate[2] | soundUpdate[3]) != 0 {
    for i in 0..4 { soundUpdate[i] = 0 }
    wrtpsg(0x0d, soundS)
    var e: u16 = soundEnvelopeTable[soundM]
    wrtpsg(0x0b, e as u8)
    wrtpsg(0x0c, (e >> 8) as u8)
    wrtpsg(0x07, soundRegister[0x07])
  }
}

// サウンドを一時停止する
fn SystemSuspendSound() {
  flag |= 1 << FLAG_SOUND_SLEEP
  wrtpsg(0x07, 0xbf)
}

// サウンドを再開する
fn SystemResumeSound() {
  flag &= (1 << FLAG_SOUND_SLEEP) ^ 0xff
  for i in 0..4 { soundUpdate[i] = 1 }
}

