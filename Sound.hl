// Sound.hl : Sound.c の写し。サウンドライブラリ（MML を読んで PSG を鳴らす）。
// 4 チャンネルの MML を 1 フレームに 1 ステップずつ進める。チャンネル 3 は PSG の C と同じ音源を使い、
// 鳴っている間はチャンネル 2 の出力を止める（元の asm と同じ）。

import "msx.hl"
import "System.hl"

data soundToneFrequencyTable: u16 = [
  0x07f2, 0x0780, 0x0714, 0x06af, 0x0d5d, 0x0c9c, 0x0be7, 0x0b3c, 0x0a9b, 0x0a02, 0x0a02, 0x0973, 0x08eb, 0x086b, 0x0000, 0x0000,
  0x03f9, 0x03c0, 0x038a, 0x0357, 0x06af, 0x064e, 0x05f4, 0x059e, 0x054e, 0x0501, 0x0501, 0x04ba, 0x0476, 0x0436, 0x0000, 0x0000,
  0x01fd, 0x01e0, 0x01c5, 0x01ac, 0x0357, 0x0327, 0x02fa, 0x02cf, 0x02a7, 0x0281, 0x0281, 0x025d, 0x023b, 0x021b, 0x0000, 0x0000,
  0x00fe, 0x00f0, 0x00e3, 0x00d6, 0x01ac, 0x0194, 0x017d, 0x0168, 0x0153, 0x0140, 0x0140, 0x012e, 0x011d, 0x010d, 0x0000, 0x0000,
  0x007f, 0x0078, 0x0071, 0x006b, 0x00d6, 0x00ca, 0x00be, 0x00b4, 0x00aa, 0x00a0, 0x00a0, 0x0097, 0x008f, 0x0087, 0x0000, 0x0000,
