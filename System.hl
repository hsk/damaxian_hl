// System.hl : System.c / System.h の写し。システムライブラリ（キー入力、ビデオ、スプライト）。
// 元の asm は hlang で書き直した。VDP のポートは MSX1 の固定値（0x98 / 0x99）を使う。

import "msx.hl"
import "vdp.hl"

// マクロの定義
// フラグ
const FLAG_H_TIMI = 0
const FLAG_SOUND_SLEEP = 1
const FLAG_CANCEL = 7
// リクエスト
const REQUEST_NULL = 0
const REQUEST_VIDEO_REGISTER = 1
const REQUEST_VRAM = 2
// キー入力
const INPUT_KEY_UP = 0
const INPUT_KEY_DOWN = 1
const INPUT_KEY_LEFT = 2
const INPUT_KEY_RIGHT = 3
const INPUT_BUTTON_SPACE = 4
const INPUT_BUTTON_RETURN = 5
const INPUT_BUTTON_ESC = 6
const INPUT_BUTTON_STOP = 7
const INPUT_SIZE = 8
// ビデオ
const VIDEO_TEXT1 = 0
const VIDEO_GRAPHIC1 = 1
const VIDEO_GRAPHIC2 = 2
const VIDEO_MULTICOLOR = 3
const VIDEO_GRAPHIC1_PATTERN_NAME_TABLE = 0x1800
const VIDEO_GRAPHIC1_PATTERN_GENERATOR_TABLE = 0x0000
const VIDEO_GRAPHIC1_COLOR_TABLE = 0x2000
const VIDEO_GRAPHIC1_SPRITE_ATTRIBUTE_TABLE = 0x1b00
const VIDEO_GRAPHIC1_SPRITE_GENERATOR_TABLE = 0x3800
const VIDEO_TRANSFER_VRAM_SIZE = 4

// VRAM の転送（V-Blank 中に転送元 src のデータを VRAM の dst へ bytes バイト送る。src が 0 なら何もしない）
struct VideoTransfer { src: u16, dst: u16, bytes: u8 }

// 変数の定義
var flag: u8                                  // フラグ
var request: u8                               // リクエスト
var input: [u8; INPUT_SIZE]                   // キー入力（押しているフレーム数。255 で止まる）
var videoRegister: [u8; 8]                    // ビデオ
var videoTransfer: [VideoTransfer; 4]
var sprites: [u8; 128]                         // スプライト

// 定数の定義
data inputStickTable: u8 = [                  // キー入力
  0x00,
  1 << INPUT_KEY_UP,
  (1 << INPUT_KEY_UP) | (1 << INPUT_KEY_RIGHT),
  1 << INPUT_KEY_RIGHT,
  (1 << INPUT_KEY_DOWN) | (1 << INPUT_KEY_RIGHT),
  1 << INPUT_KEY_DOWN,
  (1 << INPUT_KEY_DOWN) | (1 << INPUT_KEY_LEFT),
  1 << INPUT_KEY_LEFT,
  (1 << INPUT_KEY_UP) | (1 << INPUT_KEY_LEFT),
]
data videoScreenMode: u8 = [                  // ビデオ
  0b00000000,                                 // text 1
  0b10110000,
  0x0000 >> 10,
  0x0000 >> 6,
  0x0800 >> 11,
  0x1b00 >> 7,
  0x3800 >> 11,
  0b11110100,
  0b00000000,                                 // graphic 1
  0b10100000,
  0x1800 >> 10,
  0x2000 >> 6,
  0x0000 >> 11,
  0x1b00 >> 7,
  0x3800 >> 11,
  0b00000111,
  0b00000010,                                 // graphic 2
  0b10100000,
  0x1800 >> 10,
  0x2000 >> 6,
  0x0000 >> 11,
  0x1b00 >> 7,
  0x3800 >> 11,
  0b00000111,
  0b00000000,                                 // multi color
  0b10101000,
  0x0800 >> 10,
  0x2000 >> 6,
  0x0000 >> 11,
  0x1b00 >> 7,
  0x3800 >> 11,
  0b00000111,
]

// システムを初期化する
fn SystemInitialize() {
  flag &= 1 << FLAG_H_TIMI                    // フラグの初期化（割り込み処理中の印は残す。元は割り込みの前に呼ぶので 0 にしていた）
  SystemInitializeInput()                     // キー入力の初期化
  SystemInitializeVideo()                     // ビデオの初期化
}

// キー入力を初期化する
fn SystemInitializeInput() {
  for i in 0..INPUT_SIZE { input[i] = 0 }
}

// 押している間は 1 ずつ増え（255 で止まる）、離すと 0 に戻す
fn systemCount(i: u8, pressed: bool) {
  if pressed {
    if input[i] != 0xff { input[i] += 1 }
  } else {
    input[i] = 0
  }
}

// キーの入力を更新する
fn SystemUpdateInput() {
  // stick 1 と stick 2 の or
  var b: u8 = inputStickTable[gtstck(0)] | inputStickTable[gtstck(1)]
  systemCount(INPUT_KEY_UP, (b & (1 << INPUT_KEY_UP)) != 0)
  systemCount(INPUT_KEY_DOWN, (b & (1 << INPUT_KEY_DOWN)) != 0)
  systemCount(INPUT_KEY_LEFT, (b & (1 << INPUT_KEY_LEFT)) != 0)
  systemCount(INPUT_KEY_RIGHT, (b & (1 << INPUT_KEY_RIGHT)) != 0)
  // ボタンの取得
  systemCount(INPUT_BUTTON_SPACE, (gttrig(0) | gttrig(1)) != 0)
  var row: u8 = snsmat(7)                     // キーを押すと 0 になる
  systemCount(INPUT_BUTTON_RETURN, (row & 0x80) == 0)
  systemCount(INPUT_BUTTON_ESC, (row & 0x04) == 0)
  systemCount(INPUT_BUTTON_STOP, (row & 0x10) == 0)
}

// ビデオを初期化する
fn SystemInitializeVideo() {
  // レジスタの取得
  for i in 0..8 { videoRegister[i] = mem[RG0SAV + i] }
  // VRAM の転送の初期化
  for i in 0..VIDEO_TRANSFER_VRAM_SIZE {
    videoTransfer[i].src = 0
    videoTransfer[i].dst = 0
    videoTransfer[i].bytes = 0
  }
}

// スクリーンモードを設定する
fn SystemSetScreenMode(mode: u8) {
  var hl: u16 = &videoScreenMode + ((mode as u16) << 3)
  for i in 0..8 { videoRegister[i] = mem[hl + i] }
  SystemTransferVideoRegister()               // レジスタの転送
}

// レジスタを転送する
fn SystemTransferVideoRegister() {
  di()
  for i in 0..8 {
    port[VDP_CTRL] = videoRegister[i]
    port[VDP_CTRL] = 0x80 + i
  }
  ei()
}

// VRAM にデータを転送する
// 転送の欄は 5 バイト（src, dst, bytes）。番地で歩く。空き（src が 0）にするのは src だけでよい
// TODO(コンパイラ): `videoTransfer[i].src` のように配列の構造体の欄を読むと、i から番地を毎回作り直す（約 2.4 倍遅い）。mem16 で回避
fn SystemTransferVram() {
  var t: u16 = &videoTransfer
  di()
  for i in 0..VIDEO_TRANSFER_VRAM_SIZE {
    var src: u16 = mem16[t]
    if src != 0 {
      var dst: u16 = mem16[t + 2]
      port[VDP_CTRL] = dst as u8
      port[VDP_CTRL] = ((dst >> 8) as u8) | 0x40
      outs(VDP_DATA, src, mem[t + 4])
      mem16[t] = 0                            // 転送の完了
    }
    t += 5
  }
  ei()
}

// スプライトをクリアする
fn SystemClearSprite() {
  for i in 0..128 { sprites[i] = 0xc0 }
}

// スプライトを転送する
fn SystemTransferSprite() {
  var at: u16 = (videoRegister[VDP_R5] as u16) << 7     // スプライトアトリビュートテーブル
  di()
  port[VDP_CTRL] = at as u8
  port[VDP_CTRL] = ((at >> 8) as u8) | 0x40
  outs(VDP_DATA, &sprites, 128)
  ei()
}

// スプライトを設定する。hl はスプライトデータ（y, x, パターン, 色）、de は sprite の中の書き込み位置
// TODO(コンパイラ): 4 番目の引数 x がメモリ渡し、sx が毎回メモリ経由（1 回最大 320T）
fn SystemSetSprite(hl: u16, de: u16, y: u8, x: u8) {
  mem[de] = mem[hl] + y
  mem[de + 2] = mem[hl + 2]
  var sx: u8 = mem[hl + 1] + x
  var color: u8 = mem[hl + 3]
  if sx >= 0xf0 {                             // 画面の左にはみ出した分は early clock で出す
    sx += 0x20
    color |= 0x80
  }
  mem[de + 1] = sx
  mem[de + 3] = color
}

// スプライトを消す（y を 0xc0 にする）。de は sprite の中の書き込み位置
fn SystemHideSprite(de: u16) {
  mem[de] = 0xc0
  mem[de + 1] = 0xc0
  mem[de + 2] = 0xc0
  mem[de + 3] = 0xc0
}

// VRAM にメモリを転送する
fn LoadVram(vram: u16, addr: u16, size: u16) {
  ldirvm(addr, vram, size)
}

// VRAM を同じ値で埋める
fn SetVram(vram: u16, data_: u8, size: u16) {
  filvrm(vram, size, data_)
}
